# =============================================================================
# Goana AR - Environment Variables
# =============================================================================
# Required - get these from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://uqbkcirhsuupzxiwjbsz.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_gmwxGfWHiJy2uP_FNyJ_0g_RTThDwL9

# Optional - Web push notifications for the chef orders panel
# Generate keys with: npx web-push generate-vapid-keys
# Then set VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT as Supabase edge function secrets.
VITE_VAPID_PUBLIC_KEY=

# Optional - Cloudflare R2 for AR model storage (.glb/.usdz files)
# Leave VITE_USE_CLOUFLARE_R2=false to use Supabase Storage (fully functional default)
VITE_USE_CLOUDFLARE_R2=false
VITE_R2_PUBLIC_URL=

# NOTE: Never put secret keys (Supabase service role, R2 access keys, TABLE_TOKEN_SECRET)
# in this file or any VITE_ prefixed variable. Those belong in Supabase Edge Function
# secrets only (set via `supabase secrets set`). See README.md for details.
