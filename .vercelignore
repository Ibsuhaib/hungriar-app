# NOTE: once this file exists Vercel stops falling back to .gitignore, so
# everything that must stay out of the upload has to be listed here — most
# importantly node_modules (297MB) and dist (3.2MB), which .gitignore was
# previously handling.
node_modules/
dist/
dist-ssr/
build/

# Vercel builds only the Vite frontend; none of this is needed for that build
# and it only makes the upload bigger (which matters on a flaky connection).
supabase/
scripts/
.claude/
.env
.env.*
*.log
coverage/
